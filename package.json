{
  "name": "tailorit-autofill",
  "version": "0.1.0",
  "private": true,
  "description": "TailorIT Autofill: fills job applications on Greenhouse, Lever, Ashby and Workday from a TailorIT profile. You review and submit.",
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "typecheck": "wxt prepare && tsc -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p tsconfig.core-tests.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run --project core --project ext",
    "test:watch": "vitest --project core --project ext",
    "test:dom": "vitest run --project dom",
    "test:e2e": "node scripts/e2e.mjs",
    "check:build": "node scripts/check-build.mjs",
    "verify": "node scripts/verify.mjs",
    "vocab:fetch": "node scripts/vocab-fetch.mjs",
    "vocab:build": "node --import tsx scripts/vocab-build.ts"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "overrides": {
    "@wxt-dev/browser": "0.3.5",
    "@babel/traverse": "7.29.10",
    "@types/estree": "1.0.9",
    "@typescript-eslint/eslint-plugin": {
      "ignore": "7.0.13"
    },
    "browserslist": "4.29.4",
    "caniuse-lite": "1.0.30001819",
    "exsolve": "1.1.3",
    "filesize": "11.0.28",
    "magic-string": "1.4.3",
    "node-releases": "2.0.60",
    "nypm": "0.6.11",
    "pkg-types": {
      "confbox": "0.3.1"
    },
    "postcss": "8.5.31",
    "rolldown": "1.2.15",
    "superlock": "1.4.4",
    "unplugin": "3.4.0",
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.9",
    "baseline-browser-mapping": "2.11.31",
    "electron-to-chromium": "1.5.463",
    "@babel/types": "7.29.8",
    "@babel/helper-string-parser": "7.29.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
